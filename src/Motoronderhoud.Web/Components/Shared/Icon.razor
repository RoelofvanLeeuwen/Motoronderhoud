@GetIcon()

@code {
    /// <summary>Naam van het icoon (bijv. "home", "menu", "close").</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Breedte en hoogte in pixels.</summary>
    [Parameter] public int Size { get; set; } = 20;

    /// <summary>Lijndikte van de SVG-stroke.</summary>
    [Parameter] public double Stroke { get; set; } = 1.8;

    private MarkupString GetIcon()
    {
        var paths = Name switch
        {
            "home"    => "<path d=\"M3 11.5 12 4l9 7.5\"/><path d=\"M5 10v10h14V10\"/><path d=\"M10 20v-6h4v6\"/>",
            "counter" => "<rect x=\"4\" y=\"6\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M9 10v4M12 10v4M15 10v4\"/>",
            "cloud"   => "<path d=\"M7 18a4 4 0 1 1 1-7.87A5 5 0 0 1 18 11a3.5 3.5 0 0 1 0 7Z\"/>",
            "table"   => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M9 4v16\"/>",
            "info"    => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v5M12 8h.01\"/>",
            "menu"    => "<path d=\"M4 7h16M4 12h16M4 17h16\"/>",
            "close"   => "<path d=\"M6 6l12 12M18 6 6 18\"/>",
            "search"  => "<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/>",
            "bell"    => "<path d=\"M6 8a6 6 0 1 1 12 0c0 4 2 5 2 7H4c0-2 2-3 2-7Z\"/><path d=\"M10 19a2 2 0 1 0 4 0\"/>",
            "sun"     => "<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4\"/>",
            "plus"    => "<path d=\"M12 5v14M5 12h14\"/>",
            "arrow"   => "<path d=\"M5 12h14M13 6l6 6-6 6\"/>",
            "sparkle" => "<path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6\"/>",
            "check"   => "<path d=\"m5 12 5 5 9-11\"/>",
            _         => ""
        };

        return (MarkupString)$"<svg width=\"{Size}\" height=\"{Size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"{Stroke.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{paths}</svg>";
    }
}
