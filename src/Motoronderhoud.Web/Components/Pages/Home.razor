@page "/"
@attribute [Authorize]

<PageTitle>Home — Motoronderhoud</PageTitle>

<div class="gc-pageheader">
    <div>
        <div class="gc-eyebrow">Welkom</div>
        <h1 class="gc-h1">Motoronderhoud</h1>
        <p class="gc-sub">De applicatie is klaar voor de eerste user story.</p>
    </div>
</div>

<div class="gc-card" style="max-width: 540px;">
    <div class="gc-card-head">
        <div class="gc-card-title">Projectstatus</div>
    </div>
    <div class="gc-card-body">
        <p style="margin: 0 0 8px; font-size: 14px; color: var(--gc-ink-2);">
            De technische basis is ingericht:
        </p>
        <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: var(--gc-ink-2); line-height: 1.8;">
            <li>Clean Architecture solution (.slnx)</li>
            <li>Core / Application / Infrastructure / Web</li>
            <li>Blazor shell gebaseerd op DefaultTemplate.zip</li>
            <li>GitHub: main en development branches aangemaakt</li>
        </ul>
    </div>
</div>
